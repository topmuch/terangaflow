generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdCampaign {
  id             String         @id @default(cuid())
  name           String
  advertiserName String
  stationId      String
  targetingSlot  String         @default("insert")
  priority       Int            @default(0)
  budgetTotal    Float          @default(0)
  budgetSpent    Float          @default(0)
  cpmCost        Float          @default(0)
  cpcCost        Float          @default(0)
  maxImpressions Int?
  status         String         @default("active")
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  station        Station        @relation(fields: [stationId], references: [id], onDelete: Cascade)
  creatives      AdCreative[]
  impressions    AdImpression[]

  @@index([startDate, endDate])
  @@index([priority])
  @@index([targetingSlot])
  @@index([status])
  @@index([stationId])
}

model AdCreative {
  id           String         @id @default(cuid())
  campaignId   String
  title        String
  body         String?
  imageUrl     String?
  linkUrl      String?
  ctaText      String         @default("En savoir plus")
  displayOrder Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  campaign     AdCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  impressions  AdImpression[]

  @@index([displayOrder])
  @@index([isActive])
  @@index([campaignId])
}

model AdImpression {
  id         String     @id @default(cuid())
  campaignId String
  creativeId String
  stationId  String
  type       String     @default("impression")
  slotType   String
  sessionId  String?
  userAgent  String?
  referrer   String?
  createdAt  DateTime   @default(now())
  creative   AdCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([slotType])
  @@index([type])
  @@index([stationId])
  @@index([creativeId])
  @@index([campaignId])
}

model AnnouncementQueue {
  id              String    @id @default(cuid())
  stationId       String
  tripId          String?
  ruleId          String?
  type            String    @default("trip_status")
  channel         String    @default("voice")
  title           String?
  message         String    @default("")
  renderedMessage String?
  payload         String?   // JSON-encoded audio segment sequence for kiosk playback
  priority        Int       @default(0)
  status          String    @default("pending")
  scheduledAt     DateTime
  retryCount      Int       @default(0)
  maxRetries      Int       @default(3)
  playedAt        DateTime?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  station         Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([priority])
  @@index([scheduledAt])
  @@index([stationId, status])
  @@index([type])
}

model BillingSubscription {
  id                       String    @id @default(cuid())
  tenantId                 String
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  plan                     String    @default("free")
  status                   String    @default("TRIALING")
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([tenantId])
}

model Line {
  id        String    @id @default(cuid())
  name      String
  code      String
  stationId String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  station   Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  trips     Trip[]

  @@index([code])
  @@index([stationId])
}

model Merchant {
  id           String    @id @default(cuid())
  name         String
  description  String?
  category     String    @default("autre")
  whatsapp     String?
  mapsUrl      String?
  promoText    String?
  promoExpiry  DateTime?
  logo         String?
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  stationId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  station      Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([displayOrder])
  @@index([category])
  @@index([isActive])
  @@index([stationId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  stationId String?
  userAgent String?
  createdAt DateTime @default(now())
  station   Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([stationId])
  @@index([createdAt])
}

model NotificationRule {
  id             String    @id @default(cuid())
  name           String
  stationId      String
  triggerFrom    String
  triggerTo      String
  channel        String    @default("voice")
  template       String
  repeatEveryMin Int       @default(0)
  repeatMaxTimes Int       @default(0)
  priority       Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  station        Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([triggerFrom, triggerTo])
  @@index([stationId])
}

model Station {
  id                String              @id @default(cuid())
  name              String
  code              String              @unique
  city              String
  country           String              @default("SN")
  address           String?
  lat               Float?
  lng               Float?
  timezone          String              @default("Africa/Dakar")
  isActive          Boolean             @default(true)
  tenantId          String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  // White-label branding fields
  customDomain      String?             @unique
  brandName         String?
  brandColor        String?             @default("#f59e0b")
  brandLogoUrl      String?
  brandFaviconUrl   String?
  adCampaigns        AdCampaign[]
  announcementQueues AnnouncementQueue[]
  lines              Line[]
  merchants          Merchant[]
  notificationRules  NotificationRule[]
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pushSubscriptions  PushSubscription[]
  tickerMessages     TickerMessage[]
  transitionLogs     TransitionLog[]
  users              User[]
  kioskAds           KioskAd[]

  @@index([city])
  @@index([isActive])
  @@index([code])
  @@index([tenantId])
  @@index([customDomain])
}

model Tenant {
  id                  String                @id @default(cuid())
  name                String
  slug                String                @unique
  logo                String?
  domain              String?               @unique
  plan                String                @default("free")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?
  billingSubscriptions BillingSubscription[]
  stations             Station[]
  users                User[]

  @@index([plan])
  @@index([slug])
}

model TickerMessage {
  id           String    @id @default(cuid())
  text         String
  type         String    @default("info")
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  stationId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  station      Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([displayOrder])
  @@index([isActive])
  @@index([stationId])
}

model TransitionLog {
  id          String   @id @default(cuid())
  tripId      String
  stationId   String
  fromStatus  String
  toStatus    String
  triggeredBy String?
  reason      String?
  createdAt   DateTime @default(now())
  station     Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([stationId])
  @@index([tripId])
}

model Trip {
  id               String          @id @default(cuid())
  lineId           String
  operatorName     String
  type             String          @default("departure") // "departure" | "arrival"
  departureTime    DateTime
  estimatedArrival DateTime
  status           String          @default("scheduled")
  platform         String?
  delayMinutes     Int             @default(0)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  transitionLogs    TransitionLog[]
  line             Line            @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([type])
  @@index([departureTime])
  @@index([lineId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  avatar        String?
  role          String    @default("STATION_MANAGER")
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  emailVerified DateTime?
  tenantId      String
  stationId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  station       Station?  @relation(fields: [stationId], references: [id])
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([role])
  @@index([stationId])
  @@index([tenantId])
  @@index([email])
}

model KioskAd {
  id              String    @id @default(cuid())
  stationId       String
  name            String
  type            String    @default("IMAGE") // 'YOUTUBE', 'VIDEO', 'IMAGE'
  url             String
  durationSeconds Int       @default(15)
  intervalMinutes Int       @default(30)
  isActive        Boolean   @default(true)
  lastPlayedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  station         Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, isActive])
}
