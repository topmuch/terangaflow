generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPERADMIN
  STATION_MANAGER
  TRANSPORTER
  MERCHANT
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
  PAUSED
}

// ─── Tenant (multi-tenant root) ───────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  domain    String?  @unique
  plan      String   @default("free") // free, starter, pro, enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  stations     Station[]
  users        User[]
  subscriptions BillingSubscription[]

  @@index([slug])
  @@index([plan])
}

// ─── Station ───────────────────────────────────────────────────────────────────

model Station {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique  // e.g. "DSS-01"
  city      String
  country   String   @default("SN")
  address   String?
  lat       Float?
  lng       Float?
  timezone  String   @default("Africa/Dakar")
  isActive  Boolean  @default(true)
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users            User[]
  lines            Line[]
  tickers          TickerMessage[]
  merchants        Merchant[]
  notificationRules NotificationRule[]
  transitionLogs   TransitionLog[]
  announcements    AnnouncementQueue[]

  @@index([tenantId])
  @@index([code])
  @@index([isActive])
  @@index([city])
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  avatar        String?
  role          Role     @default(STATION_MANAGER)
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  emailVerified DateTime?
  tenantId      String
  stationId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  station       Station? @relation(fields: [stationId], references: [id])

  @@index([email])
  @@index([tenantId])
  @@index([stationId])
  @@index([role])
  @@index([isActive])
}

// ─── Billing Subscription ─────────────────────────────────────────────────────

model BillingSubscription {
  id                  String   @id @default(cuid())
  tenantId            String
  stripeCustomerId    String?  @unique
  stripeSubscriptionId String? @unique
  plan                String   @default("free")
  status              SubscriptionStatus @default(TRIALING)
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

// ─── Line (transport route) ───────────────────────────────────────────────────

model Line {
  id        String   @id @default(cuid())
  name      String
  code      String
  stationId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  trips     Trip[]

  @@index([stationId])
  @@index([code])
}

// ─── Trip (departure/arrival) ─────────────────────────────────────────────────

model Trip {
  id              String   @id @default(cuid())
  lineId          String
  operatorName    String
  departureTime   DateTime
  estimatedArrival DateTime
  status          String   @default("scheduled") // scheduled, delayed, cancelled, departed, arrived
  platform        String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  line            Line             @relation(fields: [lineId], references: [id], onDelete: Cascade)
  transitionLogs  TransitionLog[]

  @@index([lineId])
  @@index([departureTime])
  @@index([status])
}

// ─── Notification Rule (triggers on state transitions) ────────────────────────────

model NotificationRule {
  id            String   @id @default(cuid())
  name          String
  stationId     String
  triggerFrom   String                           // e.g. "SCHEDULED"
  triggerTo     String                           // e.g. "BOARDING"
  channel       String   @default("voice")      // voice, display, push, all
  template      String                           // message with {destination}, {platform}, {delay}
  repeatEveryMin Int      @default(0)             // 0 = no repeat; >0 = repeat every N minutes
  repeatMaxTimes Int      @default(0)             // 0 = unlimited
  priority      Int      @default(0)             // higher = play first
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  station        Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId])
  @@index([triggerFrom, triggerTo])
  @@index([isActive])
}

// ─── Transition Log (audit trail for every state change) ──────────────────────

model TransitionLog {
  id            String   @id @default(cuid())
  tripId        String
  stationId     String
  fromStatus    String
  toStatus      String
  triggeredBy   String?                          // userId or "system"
  reason        String?
  createdAt     DateTime @default(now())

  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  station       Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([stationId])
  @@index([createdAt])
}

// ─── Announcement Queue (persistent queue for voice/display) ──────────────────

model AnnouncementQueue {
  id              String    @id @default(cuid())
  stationId       String
  tripId          String?
  ruleId          String?
  channel         String    @default("voice")
  message         String
  renderedMessage String?                            // template filled in
  priority        Int       @default(0)
  status          String    @default("pending")      // pending, playing, completed, failed, skipped
  scheduledAt     DateTime
  retryCount      Int       @default(0)
  maxRetries      Int       @default(3)
  playedAt        DateTime?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  station         Station?  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, status])
  @@index([scheduledAt])
  @@index([priority])
}

// ─── Merchant (partner commerce) ────────────────────────────────────────────────

model Merchant {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("autre") // restaurant, boutique, transport, service, banque, telecom, autre
  whatsapp     String?  // phone number for WhatsApp CTA
  mapsUrl      String?  // Google Maps link
  promoText    String?  // optional promotional message
  promoExpiry  DateTime?
  logo        String?  // logo URL
  isActive    Boolean  @default(true)
  displayOrder Int      @default(0)
  stationId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  station     Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId])
  @@index([isActive])
  @@index([category])
  @@index([displayOrder])
}

// ─── Ticker Message (display banner) ────────────────────────────────────────────

model TickerMessage {
  id           String   @id @default(cuid())
  text         String
  type         String   @default("info")  // info, urgent, ad
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  stationId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  station      Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId])
  @@index([isActive])
  @@index([displayOrder])
}
