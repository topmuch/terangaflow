generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPERADMIN
  STATION_MANAGER
  TRANSPORTER
  MERCHANT
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
  PAUSED
}

// ─── Tenant (multi-tenant root) ───────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  domain    String?  @unique
  plan      String   @default("free") // free, starter, pro, enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  stations     Station[]
  users        User[]
  subscriptions BillingSubscription[]

  @@index([slug])
  @@index([plan])
}

// ─── Station ───────────────────────────────────────────────────────────────────

model Station {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique  // e.g. "DSS-01"
  city      String
  country   String   @default("SN")
  address   String?
  lat       Float?
  lng       Float?
  timezone  String   @default("Africa/Dakar")
  isActive  Boolean  @default(true)
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users     User[]
  lines     Line[]

  @@index([tenantId])
  @@index([code])
  @@index([isActive])
  @@index([city])
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  avatar        String?
  role          Role     @default(STATION_MANAGER)
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  emailVerified DateTime?
  tenantId      String
  stationId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  station       Station? @relation(fields: [stationId], references: [id])

  @@index([email])
  @@index([tenantId])
  @@index([stationId])
  @@index([role])
  @@index([isActive])
}

// ─── Billing Subscription ─────────────────────────────────────────────────────

model BillingSubscription {
  id                  String   @id @default(cuid())
  tenantId            String
  stripeCustomerId    String?  @unique
  stripeSubscriptionId String? @unique
  plan                String   @default("free")
  status              SubscriptionStatus @default(TRIALING)
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

// ─── Line (transport route) ───────────────────────────────────────────────────

model Line {
  id        String   @id @default(cuid())
  name      String
  code      String
  stationId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  trips     Trip[]

  @@index([stationId])
  @@index([code])
}

// ─── Trip (departure/arrival) ─────────────────────────────────────────────────

model Trip {
  id              String   @id @default(cuid())
  lineId          String
  operatorName    String
  departureTime   DateTime
  estimatedArrival DateTime
  status          String   @default("scheduled") // scheduled, delayed, cancelled, departed, arrived
  platform        String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  line            Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@index([departureTime])
  @@index([status])
}
